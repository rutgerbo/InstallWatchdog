# Copy to keystore.properties (same folder) and fill in. NEVER commit keystore.properties or the .jks file.
# Paths are relative to the project root. Keep a backup of the .jks file and these passwords:
# without them you can never publish an update that installs over your existing APK.
storeFile=../keys/installwatchdog-release.jks
storePassword=CHANGE_ME
keyAlias=installwatchdog
keyPassword=CHANGE_ME
